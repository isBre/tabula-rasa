; Engine configuration file.
config_version=5

[application]

config/name="Tabula Rasa"
config/description="Un mondo vuoto e due programmatori: tu e un agente AI."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

World="*res://scripts/world.gd"
Shapes="*res://scripts/shapes.gd"
Assets="*res://scripts/assets.gd"

[debug]

settings/gdscript/always_track_call_stacks=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
